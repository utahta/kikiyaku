/* Permission dialog descriptions (placed in the main bundle's lproj) */
"NSMicrophoneUsageDescription" = "Kikiyaku uses the microphone to transcribe and translate meeting audio.";
"NSSpeechRecognitionUsageDescription" = "Kikiyaku transcribes meeting audio with on-device speech recognition. When translation is enabled, the recognized text is sent to the translation backend you selected (Anthropic, OpenAI, or a server you configure). The audio itself is never sent.";
